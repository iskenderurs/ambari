FROM hdfs-three-nn-control:20261029
ADD hadoop.tar.gz /opt/
ADD zookeeper.tar.gz /opt/
COPY distro-select conf-select params.py /usr/lib/bigtop-select/
COPY image_layout.py /lab/image_layout.py
RUN chmod 755 /usr/lib/bigtop-select/distro-select /usr/lib/bigtop-select/conf-select && python3 /lab/image_layout.py node
ENV HADOOP_CONF_DIR=/etc/hadoop/conf JAVA_HOME=/usr/lib/jvm/jre-1.8.0-openjdk
RUN dnf install -y diffutils && dnf clean all && ln -s /usr/bin/python3 /usr/bin/python
