FROM rockylinux:9@sha256:d7be1c094cc5845ee815d4632fe377514ee6ebcf8efaed6892889657e5ddaaa6
RUN dnf install -y python3 python3-pip python3-distro python3-psycopg2 \
    java-17-openjdk-headless java-1.8.0-openjdk-headless \
    krb5-server krb5-workstation openssh-server openssh-clients sudo \
    procps-ng iproute hostname tar gzip unzip which lsof psmisc \
    shadow-utils openssl findutils util-linux && dnf clean all
RUN python3 -m pip install --no-cache-dir distro==1.9.0 requests==2.32.3 \
    six==1.17.0 psutil==5.9.8 PyYAML==6.0.2
LABEL org.apache.ambari.lab="hdfs-three-nn" org.apache.ambari.lab.scope="local-synthetic"
