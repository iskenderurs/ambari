FROM hdfs-three-nn-base:20261029
ADD ambari-server.tar.gz /
ADD ambari-agent.tar.gz /
COPY image_layout.py container.py /lab/
RUN python3 /lab/image_layout.py control
ENV PYTHONPATH=/usr/lib/ambari-server/lib:/usr/lib/ambari-agent/lib
ENTRYPOINT ["python3", "/lab/container.py"]
